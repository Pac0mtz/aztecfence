modules = ["nodejs-20"]
run = "npm run dev"
hidden = [".config", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[env]
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

# One-time install on first run
[unitTest]
language = "nodejs"

# Production deployment: build the SPA, then serve it with the Express server
# (serves dist/ with SPA history-fallback plus the /api/contact endpoint).
[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm start"]

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[agent]
expertMode = true
